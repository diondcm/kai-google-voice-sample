# ====================================================================
# Gemini Voice Live Relay - Environment Configuration
# ====================================================================
# Get your Google Gemini API key from Google AI Studio:
# https://aistudio.google.com/
#
# IMPORTANT: NEVER commit your actual .env file or API keys to git!
# ====================================================================

# Google Gemini API Key (Required)
GEMINI_API_KEY=your_actual_gemini_api_key_here

# Backend Server Port (Optional, default: 3000)
PORT=3000

# Gemini Multimodal Live Model (Optional, default: gemini-3.1-flash-live-preview)
# Options: gemini-3.1-flash-live-preview, gemini-2.0-flash-exp
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
